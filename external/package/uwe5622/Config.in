config BR2_PACKAGE_UWE5622
	bool "uwe5622 (AW859A / Unisoc UWE5622) WiFi driver"
	depends on BR2_LINUX_KERNEL
	help
	  Out-of-tree kernel module for the Unisoc/Spreadtrum UWE5622
	  wireless chip, packaged as "AW859A" on Allwinner boards
	  (e.g. Orange Pi Zero2W).

	  This only builds the WiFi (unisocwcn + unisocwifi/sprdwl_ng)
	  side of the driver, not the Bluetooth-over-SDIO (tty-sdio)
	  part.

	  https://github.com/armbian/uwe5622

if BR2_PACKAGE_UWE5622

config BR2_PACKAGE_UWE5622_WIFI_PS
	bool "Enable WiFi power save"
	default n
	help
	  Corresponds to the driver's CONFIG_UNISOC_WIFI_PS option.

endif
