config BR2_TARGET_UBOOT_ROCKCHIP
    bool "Enable extra U-Boot build steps for Rockchip"
    depends on BR2_TARGET_UBOOT

config BR2_TARGET_UBOOT_ROCKCHIP_IDBLOCK
    bool "Pack a raw Rockchip idblock.bin"
    depends on BR2_TARGET_UBOOT_ROCKCHIP
    help
      Run "make.sh --idblock", producing idblock.bin: the raw ID block
      the BootROM reads from sector 0x40 of eMMC or SD.

      Leave this off for boards flashed into SPI NAND with the Rockchip
      tools. Those need "make.sh --spl" instead, which packs the
      download.bin and idblock.img pair those tools expect.

config BR2_TARGET_UBOOT_ROCKCHIP_ENV
    bool "Enable Rockchip U-Boot env"
    depends on BR2_TARGET_UBOOT_ROCKCHIP

config BR2_TARGET_UBOOT_ROCKCHIP_ENV_FILE
    string "Rockchip U-Boot env file"
    depends on BR2_TARGET_UBOOT_ROCKCHIP && BR2_TARGET_UBOOT_ROCKCHIP_ENV

config BR2_TARGET_UBOOT_ROCKCHIP_BOOT_SCRIPT
    bool "Enable Rockchip U-Boot boot script"
    depends on BR2_TARGET_UBOOT_ROCKCHIP

config BR2_TARGET_UBOOT_ROCKCHIP_BOOT_SCRIPT_FILE
    string "Rockchip U-Boot boot script file"
    depends on BR2_TARGET_UBOOT_ROCKCHIP && BR2_TARGET_UBOOT_ROCKCHIP_BOOT_SCRIPT