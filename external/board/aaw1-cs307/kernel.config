# Buildroot image additions on top of the Rockchip cs307 defconfig.

# board/aaw-common/kernel.config.part hands the kernel
# CONFIG_CMDLINE="user_debug=31 init=/etc/overlay_init". On arm64 a built-in
# command line is only honoured with one of the CMDLINE_* options, and EXTEND
# appends it after the bootloader's bootargs, so its init= is the one that wins
# over the init=/sbin/init in boot.cmd.
CONFIG_CMDLINE_EXTEND=y
