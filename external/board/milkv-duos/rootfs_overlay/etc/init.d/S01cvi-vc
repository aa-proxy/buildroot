#!/bin/sh
#
# Hardware H.264/H.265/JPEG codec of the SG2000/SG2002 (cvi-osdrv package).
#
# modprobe pulls in cv181x_sys, cv181x_base, cv181x_vcodec and
# cv181x_jpeg automatically (modules.dep is generated by depmod).
# This creates /dev/cvi_vc_enc<N> and /dev/cvi_vc_dec<N>.
#

# number of encoder/decoder channels (device nodes) to create
VENC_CHNS=1
VDEC_CHNS=1

case "$1" in
	start)
		printf "Loading cvi video codec: "
		if modprobe cvi_vc_driver MaxVencChnNum=${VENC_CHNS} MaxVdecChnNum=${VDEC_CHNS}; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	stop)
		printf "Unloading cvi video codec: "
		modprobe -r cvi_vc_driver cv181x_jpeg cv181x_vcodec cv181x_base cv181x_sys 2>/dev/null
		echo "OK"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
