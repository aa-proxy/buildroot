# U-Boot environment on the eMMC (see u-boot include/configs/evb_rv1126.h):
#   CONFIG_ENV_OFFSET        0x3f0000
#   CONFIG_ENV_OFFSET_REDUND 0x3f8000
#   CONFIG_ENV_SIZE          0x8000
# Device               Offset      Env size
/dev/mmcblk0           0x3f0000    0x8000
/dev/mmcblk0           0x3f8000    0x8000
