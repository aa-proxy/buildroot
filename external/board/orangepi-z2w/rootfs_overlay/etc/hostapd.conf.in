ctrl_interface=/var/run/hostapd
interface=wlan0
# Without this, hostapd may default to the legacy "hostap" (WEXT) driver
# backend instead of nl80211 - sprdwl_ng only implements cfg80211/nl80211,
# so hostapd would report AP-ENABLED without ever actually transmitting
# a beacon.
driver=nl80211

# 5 GHz AP mode was thought broken on sprdwl_ng/UWE5622 (hostapd
# reported AP-ENABLED but never actually transmitted a beacon), so
# this used to be hardcoded to 2.4 GHz/channel 6. Root cause found
# 2026-08-28: it's a hostapd 2.11+ regression on this driver, not a
# hardware limitation - fixed by forcing hostapd 2.10 for this board
# (BR2_PACKAGE_HOSTAPD_FORCE_2_10 in
# external/configs/orangepi_zero2w_defconfig). Auto-detection can
# safely pick 5 GHz again.
#
# No ieee80211be line here: hostapd 2.10 (forced for this board, see
# above) predates the EHT/WiFi 7 config keyword entirely and hard-
# errors on unknown directives ("unknown configuration item").
hw_mode={{HW_MODE}}
ieee80211ax={{AX_MODE}}
ieee80211ac={{AC_MODE}}
ieee80211n={{N_MODE}}
channel={{CHANNEL}}

auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP

ssid={{SSID}}

wpa_passphrase={{WPA_PASSPHRASE}}
country_code={{COUNTRY_CODE}}
