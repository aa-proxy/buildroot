CONFIG_CMDLINE="user_debug=31 init=/etc/overlay_init"

# Add f_accessory, f_fs and mass_storage functions for usb gadget
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_ACC=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Add usb serial gadget for debugging
CONFIG_USB_F_ACM=y
CONFIG_USB_CONFIGFS_ACM=y

# RK3308 / AAWireless 1 (rk3308-cs307-e2w3) hardware support
CONFIG_ARCH_ROCKCHIP=y
CONFIG_CLK_RK3308=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_ARM_CPUIDLE=n
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PL330_DMA=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y
CONFIG_MMC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_RESET_GPIO=n
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_HWMON=y
CONFIG_THERMAL_HWMON=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y
CONFIG_NVMEM=y
CONFIG_NVMEM_ROCKCHIP_OTP=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_DWC2=y
CONFIG_HID_SUPPORT=y

# Broadcom AP6254/AP6255/AP6256 Wi-Fi (SDIO) and Bluetooth (UART H4 + rfkill-gpio)
CONFIG_CFG80211=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_REG_RELAX_NO_IR=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RFKILL=y
CONFIG_RFKILL_GPIO=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=n

# Filesystems and boot command line
CONFIG_CMDLINE="user_debug=31"
CONFIG_CMDLINE_EXTEND=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_CONFIGFS_FS=y

# Disable bnep in bluetooth
CONFIG_BT_BNEP=n

# Disable some kernel debugging options
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_DEBUG_FS=n
CONFIG_KGDB=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_FTRACE=n
CONFIG_SLUB_DEBUG=n

# Disable selected subsystems and options
CONFIG_VIRTUALIZATION=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_W1=n
CONFIG_CAN=n
CONFIG_HAMRADIO=n
CONFIG_NFC=n
CONFIG_NET_9P=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_TCG_TPM=n

# Disable device drivers
CONFIG_ATA=n
CONFIG_MD=n
CONFIG_PPP=n
CONFIG_IEEE802154_DRIVERS=n
CONFIG_SLIP=n
CONFIG_ATM_DRIVERS=n
CONFIG_NETCONSOLE=n
CONFIG_NET_CORE=n
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n
CONFIG_RC_CORE=n
CONFIG_ACCESSIBILITY=n
CONFIG_RTC_CLASS=n
CONFIG_STAGING=n
CONFIG_SURFACE_PLATFORMS=n
CONFIG_RAS=n

# Disable filesystems
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_XFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_BTRFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_F2FS_FS=n
CONFIG_BCACHEFS_FS=n
CONFIG_QUOTA=n
CONFIG_FUSE_FS=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n
CONFIG_NTFS3_FS=n
CONFIG_ECRYPT_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_JFFS2_FS=n
CONFIG_UBIFS_FS=n
CONFIG_SQUASHFS=n
CONFIG_NETWORK_FILESYSTEMS=n

# Disable networking options
CONFIG_IPV6=n
CONFIG_XFRM_USER=n
CONFIG_XFRM_INTERFACE=n
CONFIG_XFRM_SUB_POLICY=n
CONFIG_XFRM_STATISTICS=n
CONFIG_NET_KEY=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_MULTIPLE_TABLES=n
CONFIG_IP_ROUTE_MULTIPATH=n
CONFIG_IP_ROUTE_VERBOSE=n
CONFIG_IP_PNP=n
CONFIG_NET_IPIP=n
CONFIG_NET_IPGRE_DEMUX=n
CONFIG_NET_IPVTI=n
CONFIG_INET_AH=n
CONFIG_INET_ESP=n
CONFIG_INET_IPCOMP=n
CONFIG_INET_DIAG=n
CONFIG_TCP_CONG_ADVANCED=n
CONFIG_MPTCP=n
CONFIG_NETFILTER=n
CONFIG_ATM=n
CONFIG_L2TP=n
CONFIG_VLAN_8021Q=n
CONFIG_ATALK=n
CONFIG_6LOWPAN=n
CONFIG_IEEE802154=n
CONFIG_NET_SCHED=n
CONFIG_BATMAN_ADV=n
CONFIG_OPENVSWITCH=n
CONFIG_VSOCKETS=n
CONFIG_MPLS=n
CONFIG_NET_NSH=n
CONFIG_NET_L3_MASTER_DEV=n
CONFIG_NET_PKTGEN=n
CONFIG_LWTUNNEL=n

# Disable WLAN power save by default
CONFIG_CFG80211_DEFAULT_PS=n
