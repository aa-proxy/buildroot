# Hardware H.264 decoder/encoder (V4L2 M2M, bcm2835-codec) used by the
# aa-proxy-rs video overlay. Only for boards with the VideoCore VPU codec
# (Raspberry Pi 3, 4 and Zero 2 W); applied after board/common/kernel.config.
# The driver is a module, loaded by S00modules when it is present.
CONFIG_STAGING=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=n
CONFIG_MEDIA_ANALOG_TV_SUPPORT=n
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_MEDIA_SDR_SUPPORT=n
CONFIG_MEDIA_TEST_SUPPORT=n
CONFIG_MEDIA_PCI_SUPPORT=n
CONFIG_MEDIA_USB_SUPPORT=n
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_CODEC_BCM2835=m

# Drop the camera/webcam/staging leftovers pulled in by the options above
CONFIG_STAGING_MEDIA_DEPRECATED=n
CONFIG_FB_TFT=n
CONFIG_VT6656=n
CONFIG_VIDEO_BCM2835=n
CONFIG_VIDEO_ISP_BCM2835=n
CONFIG_VIDEO_RPI_HEVC_DEC=n
CONFIG_VIDEO_BCM2835_UNICAM=n
CONFIG_VIDEO_BCM2835_UNICAM_LEGACY=n
CONFIG_VIDEO_RASPBERRYPI_PISP_BE=n
CONFIG_VIDEO_RP1_CFE=n
CONFIG_USB_CONFIGFS_F_UVC=n
CONFIG_USB_G_WEBCAM=n
